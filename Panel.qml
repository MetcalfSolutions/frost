import QtQuick
import QtQuick.Controls
import QtQuick.Layouts
import Quickshell
import Quickshell.Io
import qs.Ui
import qs.Commons
import qs.Commons as Commons

Panel {
  id: root
  moduleName: "frost.panel"
  ipcTarget: "frost.panel"

  implicitWidth: button.implicitWidth
  implicitHeight: button.implicitHeight

  Commons.Translations {
    id: strings
    directory: Qt.resolvedUrl("i18n")
  }

  component PlainText: Text {
    textFormat: Text.PlainText
  }

  property real activeOpacity: 1.0
  property real inactiveOpacity: 1.0
  property bool syncOpacity: false
  property int blurSize: 4
  property int blurPasses: 2
  property real blurNoise: 0.01
  property real blurContrast: 1.0
  property real blurBrightness: 0.75
  property real blurVibrancy: 0.35

  property bool fineTuningOpen: false
  property string statusText: ""

  onOpenedChanged: {
    if (opened) {
      statusText = ""
      queryProc.running = true
    }
  }

  Process {
    id: queryProc
    command: [
      "bash", "-c",
      "if command -v frost >/dev/null 2>&1; then frost get --json; elif [ -f ~/.local/state/omarchy/toggles/hypr/zz-frost.lua ]; then " +
      "awk '/active_opacity/ { gsub(/[^0-9.]/, \"\", $0); a=$0 } /inactive_opacity/ { gsub(/[^0-9.]/, \"\", $0); i=$0 } /size =/ { gsub(/[^0-9]/, \"\", $0); s=$0 } /passes =/ { gsub(/[^0-9]/, \"\", $0); p=$0 } /noise =/ { gsub(/[^0-9.]/, \"\", $0); n=$0 } /contrast =/ { gsub(/[^0-9.]/, \"\", $0); c=$0 } /brightness =/ { gsub(/[^0-9.]/, \"\", $0); b=$0 } /vibrancy =/ { gsub(/[^0-9.]/, \"\", $0); v=$0 } END { printf \"{\\\"active_opacity\\\":%s,\\\"inactive_opacity\\\":%s,\\\"blur_size\\\":%s,\\\"blur_passes\\\":%s,\\\"blur_noise\\\":%s,\\\"blur_contrast\\\":%s,\\\"blur_brightness\\\":%s,\\\"blur_vibrancy\\\":%s}\\n\", (a?a:\"1.0\"), (i?i:\"1.0\"), (s?s:\"4\"), (p?p:\"2\"), (n?n:\"0.01\"), (c?c:\"1.0\"), (b?b:\"0.75\"), (v?v:\"0.35\") }' ~/.local/state/omarchy/toggles/hypr/zz-frost.lua; fi"
    ]
    stdout: StdioCollector {
      waitForEnd: true
      onStreamFinished: {
        try {
          var d = JSON.parse(text)
          if (d.active_opacity !== undefined) root.activeOpacity = Number(d.active_opacity)
          if (d.inactive_opacity !== undefined) root.inactiveOpacity = Number(d.inactive_opacity)
          if (d.sync_opacity !== undefined) root.syncOpacity = !!d.sync_opacity
          if (d.blur_size !== undefined) root.blurSize = Math.round(Number(d.blur_size))
          if (d.blur_passes !== undefined) root.blurPasses = Math.round(Number(d.blur_passes))
          if (d.blur_noise !== undefined) root.blurNoise = Number(d.blur_noise)
          if (d.blur_contrast !== undefined) root.blurContrast = Number(d.blur_contrast)
          if (d.blur_brightness !== undefined) root.blurBrightness = Number(d.blur_brightness)
          if (d.blur_vibrancy !== undefined) root.blurVibrancy = Number(d.blur_vibrancy)
        } catch (e) {}
      }
    }
  }

  function applyLive() {
    var lua = "hl.config({ decoration = { active_opacity = " + root.activeOpacity.toFixed(2) +
              ", inactive_opacity = " + root.inactiveOpacity.toFixed(2) +
              ", blur = { enabled = true, size = " + root.blurSize +
              ", passes = " + root.blurPasses +
              ", noise = " + root.blurNoise.toFixed(4) +
              ", contrast = " + root.blurContrast.toFixed(2) +
              ", brightness = " + root.blurBrightness.toFixed(2) +
              ", vibrancy = " + root.blurVibrancy.toFixed(2) + " } } })"
    Util.execArgv(["hyprctl", "eval", lua])
    saveTimer.restart()
  }

  function saveToFile() {
    var luaCode = "-- Generated by Frost\\nhl.config({\\n  decoration = {\\n    active_opacity = " + root.activeOpacity.toFixed(2) + ",\\n    inactive_opacity = " + root.inactiveOpacity.toFixed(2) + ",\\n    blur = {\\n      enabled = true,\\n      size = " + root.blurSize + ",\\n      passes = " + root.blurPasses + ",\\n      noise = " + root.blurNoise.toFixed(4) + ",\\n      contrast = " + root.blurContrast.toFixed(2) + ",\\n      brightness = " + root.blurBrightness.toFixed(2) + ",\\n      vibrancy = " + root.blurVibrancy.toFixed(2) + "\\n    }\\n  }\\n})\\n";

    var cmd = "if command -v frost >/dev/null 2>&1; then " +
              "frost set --active-opacity " + root.activeOpacity.toFixed(2) +
              " --inactive-opacity " + root.inactiveOpacity.toFixed(2) +
              " --blur-size " + root.blurSize +
              " --blur-passes " + root.blurPasses +
              " --noise " + root.blurNoise.toFixed(4) +
              " --contrast " + root.blurContrast.toFixed(2) +
              " --brightness " + root.blurBrightness.toFixed(2) +
              " --vibrancy " + root.blurVibrancy.toFixed(2) + "; " +
              "else " +
              "mkdir -p ~/.local/state/omarchy/toggles/hypr ~/.config/hypr; " +
              "cat << 'EOF' > ~/.local/state/omarchy/toggles/hypr/zz-frost.lua\n" + luaCode + "EOF\n" +
              "cp ~/.local/state/omarchy/toggles/hypr/zz-frost.lua ~/.config/hypr/frost.lua; " +
              "hyprctl reload config-only; " +
              "fi";

    Util.execArgv(["bash", "-c", cmd])
    root.statusText = strings.t("panel.saved", "Saved")
  }

  function resetDefaults() {
    var defaultLua = "-- Generated by Frost\\nhl.config({\\n  decoration = {\\n    active_opacity = 1.0,\\n    inactive_opacity = 1.0,\\n    blur = { enabled = true, size = 4, passes = 2, noise = 0.0100, contrast = 1.00, brightness = 0.75, vibrancy = 0.35 }\\n  }\\n})\\n";
    var cmd = "if command -v frost >/dev/null 2>&1; then frost reset; else " +
              "mkdir -p ~/.local/state/omarchy/toggles/hypr ~/.config/hypr; " +
              "cat << 'EOF' > ~/.local/state/omarchy/toggles/hypr/zz-frost.lua\n" + defaultLua + "EOF\n" +
              "cp ~/.local/state/omarchy/toggles/hypr/zz-frost.lua ~/.config/hypr/frost.lua; " +
              "hyprctl reload config-only; fi";
    Util.execArgv(["bash", "-c", cmd])
    root.activeOpacity = 1.0
    root.inactiveOpacity = 1.0
    root.syncOpacity = false
    root.blurSize = 4
    root.blurPasses = 2
    root.blurNoise = 0.01
    root.blurContrast = 1.00
    root.blurBrightness = 0.75
    root.blurVibrancy = 0.35
    root.statusText = strings.t("panel.reset_done", "Reset to defaults")
  }

  Timer {
    id: saveTimer
    interval: Style.duration(350)
    repeat: false
    onTriggered: root.saveToFile()
  }

  BarIconButton {
    id: button
    anchors.fill: parent
    bar: root.bar
    text: ""
    tooltipText: strings.t("tooltip", "Frost — Window Glass")
    onPressed: function(b) {
      if (b === Qt.RightButton) root.resetDefaults()
      else root.toggle()
    }
  }

  KeyboardPanel {
    id: panel
    anchorItem: button
    owner: root
    bar: root.bar
    open: root.opened
    contentWidth: Style.space(340)
    contentHeight: Math.min(Style.space(480), cardContent.implicitHeight + Style.space(24))

    ScrollView {
      anchors.fill: parent
      clip: true
      ScrollBar.vertical: ScrollBar {
        policy: ScrollBar.AsNeeded
        active: true
      }

      ColumnLayout {
        id: cardContent
        width: parent.width - Style.space(8)
        spacing: Style.space(12)

        // Header Row
        RowLayout {
          Layout.fillWidth: true
          spacing: Style.space(8)

          PlainText {
            text: strings.t("panel.title", "Frost")
            font.family: root.bar ? root.bar.fontFamily : Style.font.family
            font.pixelSize: Style.font.heading
            font.bold: true
            color: root.bar ? root.bar.foreground : Commons.Color.foreground
          }

          PlainText {
            text: strings.t("panel.subtitle", "Glass & Blur")
            font.family: root.bar ? root.bar.fontFamily : Style.font.family
            font.pixelSize: Style.font.caption
            color: root.bar ? Qt.darker(root.bar.foreground, 1.4) : "#888"
            Layout.alignment: Qt.AlignBaseline
          }

          Item { Layout.fillWidth: true }

          Button {
            text: strings.t("panel.reset", "Reset")
            onClicked: root.resetDefaults()
          }
        }

        // Section: Opacity
        ColumnLayout {
          Layout.fillWidth: true
          spacing: Style.space(6)

          RowLayout {
            Layout.fillWidth: true
            PlainText {
              text: strings.t("panel.focused_opacity", "Focused Opacity")
              font.family: root.bar ? root.bar.fontFamily : Style.font.family
              font.pixelSize: Style.font.bodySmall
              color: root.bar ? root.bar.foreground : Commons.Color.foreground
            }
            Item { Layout.fillWidth: true }
            PlainText {
              text: Commons.I18n.formatNumber(Math.round(root.activeOpacity * 100)) + "%"
              font.family: root.bar ? root.bar.fontFamily : Style.font.family
              font.pixelSize: Style.font.bodySmall
              font.bold: true
              color: Commons.Color.accent
            }
          }

          PanelSlider {
            bar: root.bar
            width: parent.width
            minimum: 0.20
            maximum: 1.00
            step: 0.01
            value: root.activeOpacity
            onMoved: function(v) {
              root.activeOpacity = v
              if (root.syncOpacity) root.inactiveOpacity = v
              root.applyLive()
            }
            onReleased: function(v) {
              root.saveToFile()
            }
          }

          RowLayout {
            Layout.fillWidth: true
            PlainText {
              text: strings.t("panel.unfocused_opacity", "Unfocused Opacity")
              font.family: root.bar ? root.bar.fontFamily : Style.font.family
              font.pixelSize: Style.font.bodySmall
              color: root.syncOpacity ? "#666" : (root.bar ? root.bar.foreground : Commons.Color.foreground)
            }
            Item { Layout.fillWidth: true }
            PlainText {
              text: Commons.I18n.formatNumber(Math.round(root.inactiveOpacity * 100)) + "%"
              font.family: root.bar ? root.bar.fontFamily : Style.font.family
              font.pixelSize: Style.font.bodySmall
              font.bold: true
              color: root.syncOpacity ? "#666" : Commons.Color.accent
            }
          }

          PanelSlider {
            bar: root.bar
            width: parent.width
            enabled: !root.syncOpacity
            opacity: root.syncOpacity ? 0.45 : 1.0
            minimum: 0.20
            maximum: 1.00
            step: 0.01
            value: root.inactiveOpacity
            onMoved: function(v) {
              root.inactiveOpacity = v
              root.applyLive()
            }
            onReleased: function(v) {
              root.saveToFile()
            }
          }

          RowLayout {
            Layout.fillWidth: true
            PlainText {
              text: strings.t("panel.link_focused", "Link focused & unfocused")
              font.family: root.bar ? root.bar.fontFamily : Style.font.family
              font.pixelSize: Style.font.bodySmall
              color: root.bar ? root.bar.foreground : Commons.Color.foreground
            }
            Item { Layout.fillWidth: true }
            ToggleSwitch {
              checked: root.syncOpacity
              onToggled: {
                root.syncOpacity = !root.syncOpacity
                if (root.syncOpacity) {
                  root.inactiveOpacity = root.activeOpacity
                  root.applyLive()
                }
              }
            }
          }
        }

        Rectangle {
          Layout.fillWidth: true
          height: 1
          color: root.bar ? Style.selectedFillFor(root.bar.foreground, Commons.Color.accent) : "#282828"
        }

        // Section: Blur
        ColumnLayout {
          Layout.fillWidth: true
          spacing: Style.space(6)

          RowLayout {
            Layout.fillWidth: true
            PlainText {
              text: strings.t("panel.blur_radius", "Blur Radius (Size)")
              font.family: root.bar ? root.bar.fontFamily : Style.font.family
              font.pixelSize: Style.font.bodySmall
              color: root.bar ? root.bar.foreground : Commons.Color.foreground
            }
            Item { Layout.fillWidth: true }
            PlainText {
              text: Commons.I18n.formatNumber(root.blurSize) + " px"
              font.family: root.bar ? root.bar.fontFamily : Style.font.family
              font.pixelSize: Style.font.bodySmall
              font.bold: true
              color: Commons.Color.accent
            }
          }

          PanelSlider {
            bar: root.bar
            width: parent.width
            minimum: 1
            maximum: 15
            step: 1
            integer: true
            value: root.blurSize
            onMoved: function(v) {
              root.blurSize = Math.round(v)
              root.applyLive()
            }
            onReleased: function(v) {
              root.saveToFile()
            }
          }

          RowLayout {
            Layout.fillWidth: true
            PlainText {
              text: strings.t("panel.blur_depth", "Blur Depth (Passes)")
              font.family: root.bar ? root.bar.fontFamily : Style.font.family
              font.pixelSize: Style.font.bodySmall
              color: root.bar ? root.bar.foreground : Commons.Color.foreground
            }
            Item { Layout.fillWidth: true }
            PlainText {
              text: strings.tn("panel.passes", root.blurPasses).arg(Commons.I18n.formatNumber(root.blurPasses))
              font.family: root.bar ? root.bar.fontFamily : Style.font.family
              font.pixelSize: Style.font.bodySmall
              font.bold: true
              color: Commons.Color.accent
            }
          }

          PanelSlider {
            bar: root.bar
            width: parent.width
            minimum: 1
            maximum: 4
            step: 1
            integer: true
            value: root.blurPasses
            onMoved: function(v) {
              root.blurPasses = Math.round(v)
              root.applyLive()
            }
            onReleased: function(v) {
              root.saveToFile()
            }
          }
        }

        // Section: Fine Tuning (Collapsible)
        RowLayout {
          Layout.fillWidth: true
          PlainText {
            text: strings.t("panel.fine_tuning", "Fine Tuning")
            font.family: root.bar ? root.bar.fontFamily : Style.font.family
            font.pixelSize: Style.font.bodySmall
            font.bold: true
            color: root.bar ? root.bar.foreground : Commons.Color.foreground
          }
          Item { Layout.fillWidth: true }
          Button {
            text: root.fineTuningOpen ? strings.t("panel.collapse", "Collapse ▲") : strings.t("panel.expand", "Expand ▼")
            onClicked: root.fineTuningOpen = !root.fineTuningOpen
          }
        }

        ColumnLayout {
          Layout.fillWidth: true
          visible: root.fineTuningOpen
          spacing: Style.space(6)

          RowLayout {
            Layout.fillWidth: true
            PlainText {
              text: strings.t("panel.noise", "Noise (Grain)")
              font.family: root.bar ? root.bar.fontFamily : Style.font.family
              font.pixelSize: Style.font.caption
              color: root.bar ? Qt.darker(root.bar.foreground, 1.3) : "#aaa"
            }
            Item { Layout.fillWidth: true }
            PlainText {
              text: Commons.I18n.formatNumber(root.blurNoise, 3)
              font.family: root.bar ? root.bar.fontFamily : Style.font.family
              font.pixelSize: Style.font.caption
              color: Commons.Color.accent
            }
          }

          PanelSlider {
            bar: root.bar
            width: parent.width
            minimum: 0.00
            maximum: 0.10
            step: 0.005
            value: root.blurNoise
            onMoved: function(v) { root.blurNoise = v; root.applyLive() }
            onReleased: function(v) { root.saveToFile() }
          }

          RowLayout {
            Layout.fillWidth: true
            PlainText {
              text: strings.t("panel.vibrancy", "Vibrancy")
              font.family: root.bar ? root.bar.fontFamily : Style.font.family
              font.pixelSize: Style.font.caption
              color: root.bar ? Qt.darker(root.bar.foreground, 1.3) : "#aaa"
            }
            Item { Layout.fillWidth: true }
            PlainText {
              text: Commons.I18n.formatNumber(root.blurVibrancy, 2)
              font.family: root.bar ? root.bar.fontFamily : Style.font.family
              font.pixelSize: Style.font.caption
              color: Commons.Color.accent
            }
          }

          PanelSlider {
            bar: root.bar
            width: parent.width
            minimum: 0.00
            maximum: 1.00
            step: 0.05
            value: root.blurVibrancy
            onMoved: function(v) { root.blurVibrancy = v; root.applyLive() }
            onReleased: function(v) { root.saveToFile() }
          }

          RowLayout {
            Layout.fillWidth: true
            PlainText {
              text: strings.t("panel.contrast", "Contrast")
              font.family: root.bar ? root.bar.fontFamily : Style.font.family
              font.pixelSize: Style.font.caption
              color: root.bar ? Qt.darker(root.bar.foreground, 1.3) : "#aaa"
            }
            Item { Layout.fillWidth: true }
            PlainText {
              text: Commons.I18n.formatNumber(root.blurContrast, 2)
              font.family: root.bar ? root.bar.fontFamily : Style.font.family
              font.pixelSize: Style.font.caption
              color: Commons.Color.accent
            }
          }

          PanelSlider {
            bar: root.bar
            width: parent.width
            minimum: 0.50
            maximum: 2.00
            step: 0.05
            value: root.blurContrast
            onMoved: function(v) { root.blurContrast = v; root.applyLive() }
            onReleased: function(v) { root.saveToFile() }
          }

          RowLayout {
            Layout.fillWidth: true
            PlainText {
              text: strings.t("panel.brightness", "Brightness")
              font.family: root.bar ? root.bar.fontFamily : Style.font.family
              font.pixelSize: Style.font.caption
              color: root.bar ? Qt.darker(root.bar.foreground, 1.3) : "#aaa"
            }
            Item { Layout.fillWidth: true }
            PlainText {
              text: Commons.I18n.formatNumber(root.blurBrightness, 2)
              font.family: root.bar ? root.bar.fontFamily : Style.font.family
              font.pixelSize: Style.font.caption
              color: Commons.Color.accent
            }
          }

          PanelSlider {
            bar: root.bar
            width: parent.width
            minimum: 0.50
            maximum: 1.50
            step: 0.05
            value: root.blurBrightness
            onMoved: function(v) { root.blurBrightness = v; root.applyLive() }
            onReleased: function(v) { root.saveToFile() }
          }
        }

        // Footer Row
        RowLayout {
          Layout.fillWidth: true
          PlainText {
            text: root.statusText ? ("● " + root.statusText) : ("● " + strings.t("panel.live_sync", "Live sync"))
            font.family: root.bar ? root.bar.fontFamily : Style.font.family
            font.pixelSize: Style.font.caption
            color: root.statusText ? Commons.Color.accent : (root.bar ? Qt.darker(root.bar.foreground, 1.5) : "#777")
          }
          Item { Layout.fillWidth: true }
          Button {
            text: strings.t("panel.open_app", "Open App")
            onClicked: {
              root.close()
              Util.execArgv(["bash", "-c", "if command -v frost >/dev/null 2>&1; then frost open; else omarchy-launch-app frost 2>/dev/null || true; fi"])
            }
          }
        }
      }
    }
  }
}
